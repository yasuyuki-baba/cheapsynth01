# Loaded after GoogleTest's discovered cases in CTestTestfile.cmake.
set(cases ${CheapSynth01Tests_TESTS})
foreach(case IN LISTS cases)
    set(labels core)
    if(case MATCHES "Observation_")
        list(APPEND labels observation)
    else()
        list(APPEND labels regression)
    endif()
    if(case MATCHES "^(OnsetObservationTest|SignalPathTest|EngineTimelineTest|CS01VCFCircuitTest|IG02610BehavioralModel|VcoSpectrumTest|ToneGeneratorRealTest|VcoBehaviorTest|MidiBehaviorTest|NumericalRecoveryTest|LfoRegressionTest|ModernFilterRegressionTest|EmpiricalStagesTest|NoiseRegressionTest|TonePitchRegressionTest|EngineTest|ToneTest|EnvelopeTest|EGContinuityTest|SourceContinuityTest|VcaGateTest|Experimental|OutputConverterTest)")
        list(APPEND labels audio dsp)
    endif()
    if(case MATCHES "^(OnsetObservationTest|SignalPathTest|EngineTimelineTest|CS01VCFCircuitTest|IG02610BehavioralModel|VcoSpectrumTest|ToneGeneratorRealTest|VcoBehaviorTest|MidiBehaviorTest|NumericalRecoveryTest|LfoRegressionTest|ModernFilterRegressionTest|EmpiricalStagesTest|TonePitchRegressionTest|EnvelopeTest|EGContinuityTest|VcaGateTest|OutputConverterTest|Experimental)")
        list(APPEND labels numerical)
    endif()
    if(case MATCHES "^(EngineTimelineTest|MidiBehaviorTest|EngineTest|MidiQueueTest|KeyboardInputTest)")
        list(APPEND labels midi)
    endif()
    if(case MATCHES "^(PresetBehaviorTest|StateTest|PresetSafetyTest|EditorSessionTest|PatchPublicationTest)")
        list(APPEND labels presets)
    endif()
    if(case MATCHES "^PatchPublicationTest")
        list(APPEND labels integration)
    endif()
    if(case MATCHES "^StateTest.(Prepared|PendingHost|InvalidPrepared|Host|ExplicitState)")
        list(APPEND labels integration)
    endif()
    if(case MATCHES "^(EngineTimelineTest|EngineTest|SourceContinuityTest.ExtendedRelease)")
        list(APPEND labels integration)
    endif()
    if(case MATCHES "^RCEnvelopeModelTest")
        list(APPEND labels research)
    endif()
    set_tests_properties("${case}" PROPERTIES LABELS "${labels}")
endforeach()
