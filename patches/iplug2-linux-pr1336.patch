+  {
+    for (int i = 0; i < sTimers.GetSize(); ++i)
+    {
+      auto* pTimer = sTimers.Get(i);
+      if (pTimer->mID == id)
+      {
+        pTimer->mCallback();
+        return;
+      }
+    }
+  }
+
+  static WDL_PtrList<LinuxAppTimer> sTimers;
+  std::function<void()> mCallback;
+  UINT_PTR mID = 0;
+};
