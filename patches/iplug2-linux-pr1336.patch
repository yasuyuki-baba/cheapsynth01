+  bool FindLinuxRunLoop()
+  {
+    mLinuxRunLoop = Steinberg::FUnknownPtr<Steinberg::Linux::IRunLoop>(plugFrame);
+    if (!mLinuxRunLoop)
+      mLinuxRunLoop = Steinberg::FUnknownPtr<Steinberg::Linux::IRunLoop>(mOwner.getHostContext());
+    if (!mLinuxRunLoop)
