+
+    .section h2 {
+      font-size: 1rem;
+      margin: 0 0 12px 0;
+      color: #cbd5e1;
+    }
+
+    .row {
+      display: flex;
+      align-items: center;
+      gap: 12px;
+      margin-bottom: 12px;
+    }
+
+    input[type="range"] {
+      flex: 1;
+    }
+  </style>
+
+  <script src="script.js"></script>
+  <script>
+    // Message tags - must match EMsgTags in IPlugReaperExtensionWebUI.h
+    const kMsgTagAddTrack = 0;
+    const kMsgTagProcessItem = 1;
+    const kMsgTagToggleDock = 2;
+    const kMsgTagSetGain = 3;
+
+    // Stubs for the "from delegate" callbacks that script.js dispatches to.
+    // IPlugReaperExtensionWebUI has no parameters, but OnWebContentLoaded still sends a params message.
+    function OnParamChange(param, value) {}
+    function OnControlChange(ctrlTag, value) {}
+    function OnMessage(msgTag, dataSize, data) {}
+
+    // Called from C++ (IPlugReaperExtensionWebUI::OnIdle) via EvaluateJavaScript
+    function OnTrackCount(n) {
+      const el = document.getElementById("trackcount");
+      if (el) el.textContent = n;
+    }
+
+    // Just updates the label. Used by OnSetGain (C++ -> UI) so it doesn't echo back to C++.
+    function OnGainInput(v) {
+      document.getElementById("gainval").textContent = v + "%";
+    }
+
+    // Slider moved by the user: update the label and push the value to C++ so mGain stays
+    // current (the media-item context-menu action reads it), even if Process is never clicked.
+    function OnGainSlider(v) {
+      OnGainInput(v);
+      SAMFUI(kMsgTagSetGain, parseInt(v));
+    }
+
+    // Called from C++ to set the slider (e.g. after loading a project)
+    function OnSetGain(pct) {
+      document.getElementById("gain").value = pct;
+      OnGainInput(pct);
+    }
+
+    // Called from C++ to reflect whether the window is docked
+    function OnDockState(docked) {
+      document.getElementById("dockbtn").textContent = docked ? "Undock window" : "Dock window";
+    }
+
+    // Send the process request; the gain (0-100) travels in the ctrlTag int.
+    function ProcessSelectedItem() {
+      const pct = parseInt(document.getElementById("gain").value);
+      SAMFUI(kMsgTagProcessItem, pct);
+    }
+  </script>
+</head>
+<body>
+  <h1>IPlugReaperExtensionWebUI</h1>
+
+  <button onclick="SAMFUI(kMsgTagAddTrack)">Add Track</button>
+  <button id="dockbtn" onclick="SAMFUI(kMsgTagToggleDock)">Dock window</button>
+
+  <div class="count">Number of tracks: <span id="trackcount">&ndash;</span></div>
+
+  <div class="section">
+    <h2>Offline processing</h2>
+    <div class="row">
+      <label for="gain">Gain</label>
+      <input type="range" id="gain" min="0" max="100" value="100" oninput="OnGainSlider(this.value)" />
+      <span id="gainval">100%</span>
+    </div>
+    <button onclick="ProcessSelectedItem()">Process Selected Item</button>
+  </div>
+</body>
+</html>
diff --git a/Examples/IPlugReaperExtensionWebUI/resources/web/script.js b/Examples/IPlugReaperExtensionWebUI/resources/web/script.js
new file mode 100644
index 0000000000000000000000000000000000000000..9a7d85469dbc58652ed9e091d2508c59414f9204
--- /dev/null
+++ b/Examples/IPlugReaperExtensionWebUI/resources/web/script.js
@@ -0,0 +1,105 @@
+// FROM DELEGATE
+
+function SPVFD(paramIdx, val) {
+  console.log("paramIdx: " + paramIdx + " value:" + val);
+  OnParamChange(paramIdx, val);
+}
+
+function SCVFD(ctrlTag, val) {
+  OnControlChange(ctrlTag, val);
+//  console.log("SCVFD ctrlTag: " + ctrlTag + " value:" + val);
+}
+
+function SCMFD(ctrlTag, msgTag, msg) {
+//  var decodedData = window.atob(msg);
+  console.log("SCMFD ctrlTag: " + ctrlTag + " msgTag:" + msgTag + "msg:" + msg);
+}
+
+function SAMFD(msgTag, dataSize, msg) {
+  OnMessage(msgTag, dataSize, msg);
+}
+
+function SMMFD(statusByte, dataByte1, dataByte2) {
+  console.log("Got MIDI Message" + statusByte + ":" + dataByte1 + ":" + dataByte2);
+}
+
+function SSMFD(offset, size, msg) {
+  console.log("Got Sysex Message");
+}
+
+// FROM UI
+// data should be a base64 encoded string
+function SAMFUI(msgTag, ctrlTag = -1, data = 0) {
+  var message = {
+    "msg": "SAMFUI",
+    "msgTag": msgTag,
+    "ctrlTag": ctrlTag,
+    "data": data
+  };
+  
+  IPlugSendMsg(message);
+}
+
+function SMMFUI(statusByte, dataByte1, dataByte2) {
+  var message = {
+    "msg": "SMMFUI",
+    "statusByte": statusByte,
+    "dataByte1": dataByte1,
+    "dataByte2": dataByte2
+  };
+  
+  IPlugSendMsg(message);
+}
+
+// data should be a base64 encoded string
+function SSMFUI(data = 0) {
+  var message = {
+    "msg": "SSMFUI",
+    "data": data
+  };
+  
+  IPlugSendMsg(message);
+}
+
+function EPCFUI(paramIdx) {
+  if (paramIdx < 0) {
+    console.log("EPCFUI paramIdx must be >= 0")
+    return;
+  }
+  
+  var message = {
+    "msg": "EPCFUI",
+    "paramIdx": parseInt(paramIdx),
+  };
+  
+  IPlugSendMsg(message);
+}
+
+function BPCFUI(paramIdx) {
+  if (paramIdx < 0) {
+    console.log("BPCFUI paramIdx must be >= 0")
+    return;
+  }
+  
+  var message = {
+    "msg": "BPCFUI",
+    "paramIdx": parseInt(paramIdx),
+  };
+  
+  IPlugSendMsg(message);
+}
+
+function SPVFUI(paramIdx, value) {
+  if (paramIdx < 0) {
+    console.log("SPVFUI paramIdx must be >= 0")
+    return;
+  }
+  
+  var message = {
+    "msg": "SPVFUI",
+    "paramIdx": parseInt(paramIdx),
+    "value": value
+  };
+
+  IPlugSendMsg(message);
+}
diff --git a/Examples/IPlugReaperExtensionWebUI/scripts/postbuild-win.bat b/Examples/IPlugReaperExtensionWebUI/scripts/postbuild-win.bat
new file mode 100644
index 0000000000000000000000000000000000000000..567ec67062834eb0a924068ae167cb41a2396579
--- /dev/null
+++ b/Examples/IPlugReaperExtensionWebUI/scripts/postbuild-win.bat
@@ -0,0 +1,32 @@
+@echo off
+
+REM - CALL "$(SolutionDir)scripts\postbuild-win.bat" "$(BINARY_NAME)" "$(Platform)" "$(TargetPath)" "$(REAPER_EXT_PATH)" "$(SolutionDir)"
+
+set BINARY_NAME=%~1
+set PLATFORM=%~2
+set BUILT_BINARY=%~3
+set REAPER_EXT_PATH=%~4
+set PROJECT_DIR=%~5
+
+REM Must match SHARED_RESOURCES_SUBPATH in config.h (where the extension loads its web UI from at runtime).
+set WEB_SUBPATH=IPlugReaperExtensionWebUI
+
+echo POSTBUILD SCRIPT VARIABLES -----------------------------------------------------
+echo BINARY_NAME %BINARY_NAME%
+echo PLATFORM %PLATFORM%
+echo BUILT_BINARY %BUILT_BINARY%
+echo REAPER_EXT_PATH %REAPER_EXT_PATH%
+echo PROJECT_DIR %PROJECT_DIR%
+echo END POSTBUILD SCRIPT VARIABLES -----------------------------------------------------
+
+if not exist "%REAPER_EXT_PATH%" (
+  echo creating REAPER UserPlugins directory: %REAPER_EXT_PATH%
+  mkdir "%REAPER_EXT_PATH%"
+)
+
+echo copying REAPER extension to: %REAPER_EXT_PATH%
+copy /y "%BUILT_BINARY%" "%REAPER_EXT_PATH%"
+
+REM Deploy the WebView UI so Release builds (which can't load from the source tree) find index.html.
+echo deploying web resources to: %REAPER_EXT_PATH%\%WEB_SUBPATH%
+xcopy /y /i /e "%PROJECT_DIR%resources\web" "%REAPER_EXT_PATH%\%WEB_SUBPATH%"
