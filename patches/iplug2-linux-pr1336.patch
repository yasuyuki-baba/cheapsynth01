+++ b/Tests/Linux/Deployment/ResourceLookup.cpp
@@ -0,0 +1,32 @@
+#include "IPlugPaths.h"
+#include <cstdio>
+#include <cstring>
+
+extern "C" bool LinuxResourceExists()
+{
+  WDL_String path;
+  return iplug::LocateResource("late.txt", "txt", path, "", nullptr, nullptr) !=
+    iplug::EResourceLocation::kNotFound;
+}
+
+extern "C" bool LinuxResourceMatches(const char* expected)
+{
+  WDL_String path;
+  if (iplug::LocateResource("late.txt", "txt", path, "", nullptr, nullptr) ==
+      iplug::EResourceLocation::kNotFound)
+    return false;
+  FILE* file = fopen(path.Get(), "rb");
+  if (!file)
+  {
+    perror(path.Get());
+    return false;
+  }
+  char contents[128] {};
+  const size_t length = fread(contents, 1, sizeof(contents), file);
+  const bool complete = fgetc(file) == EOF;
+  const bool error = ferror(file);
+  if (error)
+    perror(path.Get());
+  fclose(file);
+  return !error && complete && length == strlen(expected) && memcmp(contents, expected, length) == 0;
+}
diff --git a/Tests/Linux/Deployment/ResourceTest.cpp b/Tests/Linux/Deployment/ResourceTest.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..e0057777239e65e26ca64178d9366fe93dc8aa22
--- /dev/null
+++ b/Tests/Linux/Deployment/ResourceTest.cpp
@@ -0,0 +1,29 @@
+#include <cstdio>
+#include <cstring>
+#include <dlfcn.h>
+
+int main(int argc, char** argv)
+{
+  if (argc < 2 || argc > 3)
+    return 1;
+  void* module = dlopen(argv[1], RTLD_NOW | RTLD_LOCAL);
+  if (!module)
+  {
+    fprintf(stderr, "Could not load resource fixture: %s\n", dlerror());
+    return 1;
+  }
+  const auto exists = reinterpret_cast<bool (*)()>(dlsym(module, "LinuxResourceExists"));
+  const auto matches = reinterpret_cast<bool (*)(const char*)>(dlsym(module, "LinuxResourceMatches"));
+  const bool missing = argc == 3 && strcmp(argv[2], "--missing") == 0;
+  bool found = false;
+  if (argc == 2)
+    found = exists && exists();
+  else if (missing)
+    found = exists && !exists();
+  else
+    found = matches && matches(argv[2]);
+  if (!found)
+    fprintf(stderr, "Resource lookup failed through '%s'\n", argv[1]);
+  dlclose(module);
+  return found ? 0 : 1;
+}
